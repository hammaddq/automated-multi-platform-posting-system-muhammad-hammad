# Copy this file to .env and fill in your own values.
# .env is ignored by Git, so real keys never reach the repository.

APP_TIMEZONE=UTC
REQUEST_TIMEOUT_SECONDS=15
# Optional. Also write logs to this file, e.g. logs/posting.log
LOG_FILE=

# DEV Community - https://dev.to/settings/extensions
DEVTO_API_KEY=

# LinkedIn - app with the "Share on LinkedIn" and "Sign In with LinkedIn using OpenID Connect" products
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_PERSON_URN=urn:li:person:xxxxxxxx
LINKEDIN_API_VERSION=202610

# Threads - Meta app with the "Access the Threads API" use case
THREADS_ACCESS_TOKEN=
THREADS_USER_ID=

# Blogger - Google Cloud OAuth client with the Blogger API enabled
BLOGGER_CLIENT_ID=
BLOGGER_CLIENT_SECRET=
BLOGGER_REFRESH_TOKEN=
BLOGGER_BLOG_ID=

# Discord - Server Settings > Integrations > Webhooks
DISCORD_WEBHOOK_URL=
